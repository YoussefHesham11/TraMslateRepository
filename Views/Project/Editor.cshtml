@model TraMslate.Models.Project
@using TraMslate.Models
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";

    // The editor is one screen in two modes rather than two pages, because a
    // revisor needs the same video, timeline and quality checks the translator
    // had. Everything role-dependent branches off these.
    var isRevisor = (string)ViewBag.Role == nameof(ProjectRole.Revisor);
    var lastRound = ViewBag.LastRound as TraMslate.ViewModels.ReviewSummary;
}

@section Styles {
<link rel="stylesheet" href="~/css/timeline.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/cues.css" asp-append-version="true" />
<style>
    /* The editor shell is pinned to the viewport (see .tm-editor-wrap),
       so the page itself never scrolls and .tm-main adds no padding
       around it. Below 900px the shell returns to normal flow. */
    body { overflow: hidden; }
    .tm-main { padding: 0; min-height: 0; }
    @@media (max-width: 900px) {
        body { overflow: auto; }
        .tm-main { padding: 24px 16px; min-height: calc(100vh - var(--nav-h)); }
    }
</style>
}

<div class="tm-editor-wrap">
    @Html.AntiForgeryToken()

    <!-- ── Top Bar ── -->
    <div class="tm-editor-topbar">
        <div class="tm-editor-topbar-left">
            <a asp-controller="Dashboard" asp-action="Index" class="tm-icon-btn">
                <i class="bi bi-arrow-left"></i>
            </a>
            <button class="tm-icon-btn" id="btnTogglePanel" title="Collapse/expand the subtitle list for a larger video view">
                <i class="bi bi-layout-sidebar-inset"></i>
            </button>
            <div>
                <div class="tm-editor-title">@Model.Title</div>
                <div class="tm-editor-langs">
                    <i class="bi bi-translate"></i>
                    @Model.SourceLanguage → @Model.TargetLanguage
                </div>
            </div>
        </div>
        <div class="tm-editor-topbar-right">
            @if (isRevisor)
            {
                <span class="tm-role-badge" title="You were invited to revise this project">
                    <i class="bi bi-search"></i> Revising
                </span>
            }
            else
            {
                <select id="projectStatus" class="tm-speed-select" aria-label="Project status" asp-for="Status">
                    <option value="InProgress">In progress</option>
                    <option value="UnderReview">With revisor</option>
                    <option value="ChangesRequested">Revised</option>
                    <option value="Completed">Completed</option>
                </select>
            }
            <span id="saveStatus" role="status" class="tm-save-status">Loading…</span>
            @if (!isRevisor)
            {
                <label class="tm-btn-sm" style="cursor:pointer;" title="Import an SRT/VTT subtitle file, or a Word document with one dialogue line per paragraph">
                    <i class="bi bi-file-earmark-arrow-up"></i> Import Script
                    <input type="file" id="importScript" accept=".srt,.vtt,.docx" style="display:none;" />
                </label>
            }
            <select id="fpsSelect" class="tm-speed-select" title="Frames per second">
                <option value="23.976">23.976 fps</option>
                <option value="24">24 fps</option>
                <option value="25" selected>25 fps</option>
                <option value="29.97">29.97 fps</option>
                <option value="30">30 fps</option>
            </select>
            <button class="tm-btn-sm" id="btnExportSrt"><i class="bi bi-download"></i> SRT</button>
            <button class="tm-btn-sm" id="btnExportVtt"><i class="bi bi-download"></i> VTT</button>
            <button class="tm-btn-sm tm-btn-sm-primary" id="btnSave">
                <i class="bi bi-floppy"></i> Save
            </button>
            @if (isRevisor)
            {
                <button class="tm-btn-sm tm-btn-sm-primary" id="btnFinishReview" type="button"
                        title="Write your report and send this project back">
                    <i class="bi bi-send-check"></i> Finish review
                </button>
            }
            else
            {
                <form asp-controller="Review" asp-action="SendForReview" asp-route-id="@Model.Id"
                      method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="tm-btn-sm" id="btnSendForReview"
                            title="Hand this project to the revisor">
                        <i class="bi bi-send"></i> Send for review
                    </button>
                </form>
                <a asp-controller="Review" asp-action="People" asp-route-id="@Model.Id"
                   class="tm-icon-btn" title="People on this project and its revision history">
                    <i class="bi bi-people"></i>
                </a>
                @if ((bool)ViewBag.IsOwner)
                {
                    <a asp-controller="Project" asp-action="Settings" asp-route-id="@Model.Id"
                       class="tm-icon-btn" title="Project settings — title, languages and video">
                        <i class="bi bi-gear"></i>
                    </a>
                }
            }
        </div>
    </div>

    <!-- ── Banner: crash recovery, save conflicts ── -->
    <div class="tm-banner" id="editorBanner" role="status" hidden></div>

    @if (!isRevisor && lastRound != null)
    {
        <!-- The last report the revisor filed, so the translator never has to
             go looking for why the project came back. -->
        <details class="tm-review-summary" @(Model.Status == ProjectStatus.ChangesRequested ? "open" : "")>
            <summary>
                <i class="bi bi-journal-text"></i>
                Round @lastRound.Number from @lastRound.ReviewerName
                &nbsp;·&nbsp; @lastRound.SuggestionCount suggestion@(lastRound.SuggestionCount == 1 ? "" : "s")
                &nbsp;·&nbsp; @lastRound.FlagCount flagged
            </summary>
            <div class="tm-review-summary-body">
                @if (!string.IsNullOrWhiteSpace(lastRound.Notes))
                {
                    <p class="tm-review-summary-notes">@lastRound.Notes</p>
                }
                else
                {
                    <p class="tm-tool-hint">No written report for that round.</p>
                }
                <a asp-controller="Review" asp-action="Report" asp-route-id="@Model.Id" asp-route-number="@lastRound.Number"
                   class="tm-btn-sm"><i class="bi bi-box-arrow-up-right"></i> Full report</a>
            </div>
        </details>
    }

    <!-- ── Main Editor Body ── -->
    <div class="tm-editor-body">

        <!-- ── Left: Video + Controls ── -->
        <div class="tm-editor-left">

            <!-- Video -->
            <div class="tm-video-wrap">
                @if (!string.IsNullOrEmpty(Model.VideoPath))
                {
                    <video id="videoPlayer" controls preload="auto">
                        <source src="@Url.Action("Media", "Project", new { id = Model.Id })" />
                    </video>
                }
                else
                {
                    <div class="tm-no-video">
                        <i class="bi bi-film"></i>
                        <p>No video uploaded for this project</p>
                    </div>
                }
                <!-- Broadcast overlays -->
                <div class="tm-vid-overlay-tl">
                    <span class="tm-vid-label">PGID: @Model.Id</span>
                    <span class="tm-vid-label" id="smpteDisplay">SMPTE 00:00:00:00</span>
                </div>
                <div class="tm-vid-overlay-tr">
                    <span class="tm-vid-label">MID: @Model.Id-@DateTime.UtcNow.ToString("yyyyMMdd")</span>
                    <span class="tm-vid-label" id="mediaTimeDisplay">00:00:00,000</span>
                </div>
                <div class="tm-vid-watermark" id="vidWatermark">@User.Identity!.Name</div>
                <div class="tm-subtitle-overlay" id="subtitleOverlay"></div>
            </div>

            <!-- Controls -->
            <div class="tm-playback-controls">
                <button class="tm-icon-btn" id="btnSkipBack" title="−5s">
                    <i class="bi bi-skip-backward-fill"></i>
                </button>
                <button class="tm-icon-btn tm-play-btn" id="btnPlay" title="Play/Pause (Space)">
                    <i class="bi bi-play-fill"></i>
                </button>
                <button class="tm-icon-btn" id="btnSkipFwd" title="+5s">
                    <i class="bi bi-skip-forward-fill"></i>
                </button>
                <button class="tm-icon-btn-sm" id="btnFrameBack" title="Previous frame (,)">
                    <i class="bi bi-caret-left-fill"></i>
                </button>
                <button class="tm-icon-btn-sm" id="btnFrameFwd" title="Next frame (.)">
                    <i class="bi bi-caret-right-fill"></i>
                </button>
                <div class="tm-timecode-wrap">
                    <span class="tm-timecode" id="timecodeHMS">00:00:00</span>
                    <span class="tm-timecode-sep">:</span>
                    <span class="tm-timecode tm-timecode-frames" id="timecodeFrames">00</span>
                </div>
                <div style="flex:1;"></div>
                <label style="font-size:0.8rem; color:var(--text-muted); display:flex; align-items:center; gap:6px;">
                    Speed
                    <select id="playbackSpeed" class="tm-speed-select">
                        <option value="0.5">0.5×</option>
                        <option value="0.75">0.75×</option>
                        <option value="1" selected>1×</option>
                        <option value="1.25">1.25×</option>
                        <option value="1.5">1.5×</option>
                    </select>
                </label>
            </div>
        </div>

        <!-- ── Resize Handle ── -->
        <div class="tm-resize-handle" id="resizeHandle">
            <div class="tm-resize-grip"></div>
        </div>

        <!-- ── Right: Subtitle Events Panel ── -->
        <div class="tm-editor-right">
            <div class="tm-events-header">
                <span class="tm-events-title">Subtitles</span>
                <span class="tm-events-count" id="cueCount"></span>
                <span class="tm-events-spacer"></span>
                <button class="tm-icon-btn-sm tm-suggestions-toggle" id="btnToggleSuggestions"
                        title="Show or hide the revisor's suggestions column" aria-pressed="false">
                    <i class="bi bi-lightbulb"></i>
                    <span class="tm-suggestion-count" id="suggestionCount" hidden></span>
                </button>
                <button class="tm-icon-btn-sm" id="btnSwapColumns" title="Swap original/translation columns"><i class="bi bi-arrow-left-right"></i></button>
                <button class="tm-icon-btn-sm" id="btnExpandedView" title="Expand every cue into a full editing card" aria-pressed="false"><i class="bi bi-arrows-expand"></i></button>
                <button class="tm-icon-btn-sm" id="btnCardLayout" title="Toggle side-by-side / stacked cue layout"><i class="bi bi-layout-split"></i></button>
                <button class="tm-icon-btn-sm" id="btnToggleTools" title="Show/hide search, filters, and quick tools"><i class="bi bi-sliders"></i></button>
                <button class="tm-btn-sm tm-btn-sm-primary" id="btnAddEvent" title="Add new subtitle line">
                    <i class="bi bi-plus-lg"></i> Add Line
                </button>
            </div>
            <div class="tm-cue-headrow" aria-hidden="true">
                <span></span>
                <span class="tm-col-header-num">#</span>
                <span class="tm-col-header-time">In</span>
                <span class="tm-col-header-dur">Dur</span>
                <span class="tm-col-header-original">Original</span>
                <span class="tm-col-header-translation">Translation</span>
                <span></span>
            </div>
            <div class="tm-workspace-tools" id="workspaceTools" hidden>
                <div class="tm-progress-summary"><strong id="cueProgress">Loading subtitles…</strong><span id="cueIssues"></span></div>
                <progress id="translationProgress" max="100" value="0" aria-label="Translation progress"></progress>
                <div class="tm-tool-row">
                    <input id="cueSearch" type="search" placeholder="Search source or translation…" aria-label="Search subtitles" />
                    <select id="cueFilter" aria-label="Filter subtitles">
                        <option value="all">All cues</option>
                        <option value="untranslated">Untranslated</option>
                        <option value="issues">Needs attention</option>
                        <option value="status-0">Marked draft</option>
                        <option value="status-1">Marked done</option>
                        <option value="status-2">Marked for review</option>
                        <option value="status-3">Approved</option>
                        <option value="suggested">Has a suggestion</option>
                        <option value="flagged">Flagged by revisor</option>
                    </select>
                </div>
                <div class="tm-tool-row tm-tool-icons">
                    <button class="tm-icon-btn-sm" id="undoEdit" title="Undo"><i class="bi bi-arrow-counterclockwise"></i></button>
                    <button class="tm-icon-btn-sm" id="redoEdit" title="Redo"><i class="bi bi-arrow-clockwise"></i></button>
                    <span class="tm-tool-sep"></span>
                    <button class="tm-icon-btn-sm" id="nextUntranslated" title="Jump to next untranslated cue"><i class="bi bi-skip-end-fill"></i></button>
                    <button class="tm-icon-btn-sm" id="copySource" title="Copy source text into this cue's translation"><i class="bi bi-files"></i></button>
                    <span class="tm-tool-sep"></span>
                    <button class="tm-icon-btn-sm" id="btnSplitCue" title="Split the selected cue at the playhead"><i class="bi bi-scissors"></i></button>
                    <button class="tm-icon-btn-sm" id="btnMergeCue" title="Merge the selected cue with the next one"><i class="bi bi-arrows-collapse"></i></button>
                </div>
                <details class="tm-more-tools tm-spec-tools">
                    <summary><i class="bi bi-rulers"></i> Delivery spec</summary>
                    <div class="tm-tool-row">
                        <select id="specProfile" class="tm-speed-select" aria-label="Delivery profile" title="Quality limits to check this project against"></select>
                        <button class="tm-btn-sm" id="specReset" title="Return this profile to its preset values">Reset</button>
                    </div>
                    <div class="tm-spec-grid">
                        <label>Characters/line <input type="number" id="specChars" min="10" max="120" step="1" /></label>
                        <label>Lines <input type="number" id="specLines" min="1" max="5" step="1" /></label>
                        <label>Characters/second <input type="number" id="specCps" min="5" max="40" step="0.5" /></label>
                        <label>Min duration (s) <input type="number" id="specMinDur" min="0.2" max="5" step="0.1" /></label>
                        <label>Max duration (s) <input type="number" id="specMaxDur" min="1" max="30" step="0.5" /></label>
                        <label>Min gap (s) <input type="number" id="specGap" min="0" max="2" step="0.01" /></label>
                    </div>
                    <p class="tm-tool-hint">Every quality warning, the character counter and the reading-speed badge follow these numbers. The presets are sensible starting points, not certified specs — broadcasters and streamers revise their guidelines, so check your client's current one and adjust here. Your changes are kept with this project.</p>
                </details>
                <details class="tm-more-tools"><summary><i class="bi bi-three-dots"></i> More tools</summary>
                    <p class="tm-tool-hint" style="margin-top:10px;">Shift timing</p>
                    <div class="tm-tool-row">
                        <label style="font-size:0.8rem; color:var(--text-muted); display:flex; align-items:center; gap:6px;">
                            Shift by <input type="text" id="shiftTimecode" placeholder="00:00:00:00" value="00:00:00:00" style="width:120px; font-family:'Courier New', monospace;" aria-label="Shift amount as hours:minutes:seconds:frames, or a plain number of seconds" />
                        </label>
                        <select id="shiftDirection" class="tm-speed-select" aria-label="Shift direction" title="Move cues earlier or later">
                            <option value="1">Later (+)</option>
                            <option value="-1">Earlier (−)</option>
                        </select>
                        <button class="tm-btn-sm" id="shiftAll" title="Shift every cue's timing by this much">Shift all cues</button>
                        <button class="tm-btn-sm" id="shiftFromHere" title="Shift the selected cue and every cue after it">Shift from selected</button>
                    </div>
                    <div class="tm-tool-row">
                        <button class="tm-btn-sm" id="shiftZero" title="Shift every cue so the earliest one starts at 00:00:00,000">Zero out timing</button>
                    </div>
                    <div class="tm-tool-row">
                        <label style="font-size:0.8rem; color:var(--text-muted); display:flex; align-items:center; gap:6px;">
                            Cues # <input type="number" id="shiftFromNum" min="1" placeholder="from" style="width:70px;" aria-label="Shift range start cue number" />
                            to <input type="number" id="shiftToNum" min="1" placeholder="to" style="width:70px;" aria-label="Shift range end cue number" />
                        </label>
                        <button class="tm-btn-sm" id="shiftRange" title="Shift only the cues numbered in this range">Shift range</button>
                    </div>
                    <p class="tm-tool-hint">Enter the amount as HH:MM:SS:FF (frames use the fps selector above), HH:MM:SS, MM:SS, or plain seconds, then pick Earlier or Later — handy when the whole track has drifted out of sync with the video. A shift that would cross 00:00:00 or 24:00:00 is trimmed to the farthest safe point rather than blocked. "Zero out timing" rebases every cue so the earliest one starts at 00:00:00 — useful for scripts timed against a 1-hour broadcast offset. Cue numbers refer to the # shown on each card.</p>
                    <p class="tm-tool-hint" style="margin-top:10px;">Find &amp; replace</p>
                    <div class="tm-tool-row"><input id="findText" placeholder="Find in translations" aria-label="Find text" /><input id="replaceText" placeholder="Replace with" aria-label="Replacement text" /><button class="tm-btn-sm" id="replaceAll">Replace all</button></div>
                    <p class="tm-tool-hint">Every shortcut below is the default — customize any of them on the <a asp-controller="Settings" asp-action="Shortcuts" style="color:var(--accent);">Keyboard Shortcuts</a> page.<br />Ctrl/⌘ S: save · Ctrl/⌘ Z: undo · Ctrl/⌘ Shift Z: redo<br />Outside text fields: Space: play/pause · ← →: seek 1s · Shift + ← →: skip 5s · , / .: step one frame · I / O: mark timing · ↑ / ↓ with Ctrl: select cue.<br />Quality guidance: 42 characters per line, 2 lines, up to 21 characters/second.</p>
                </details>
            </div>
            <div class="tm-events-list" id="eventsList"></div>
        </div>

    </div>

    <!-- ── Full Width Timeline ── -->
    <div class="tm-timeline-resize-handle" id="timelineResizeHandle">
        <div class="tm-timeline-resize-grip"></div>
    </div>
    <div class="tm-timeline-toolbar">
        <div class="tm-timeline-toolbar-group" role="group" aria-label="Transport">
            <button class="tm-icon-btn-sm" id="tlRewind" title="Rewind 10 seconds"><i class="bi bi-rewind-fill"></i></button>
            <button class="tm-icon-btn-sm" id="tlPrevSub" title="Previous subtitle"><i class="bi bi-skip-start-fill"></i></button>
            <button class="tm-icon-btn-sm" id="tlPlayPause" title="Play / Pause (Space)"><i class="bi bi-play-fill"></i></button>
            <button class="tm-icon-btn-sm" id="tlStop" title="Stop and return to the selected cue's start"><i class="bi bi-stop-fill"></i></button>
            <button class="tm-icon-btn-sm" id="tlNextSub" title="Next subtitle"><i class="bi bi-skip-end-fill"></i></button>
            <button class="tm-icon-btn-sm" id="tlFastForward" title="Fast-forward 10 seconds"><i class="bi bi-fast-forward-fill"></i></button>
            <span class="tm-tool-sep"></span>
            <button class="tm-icon-btn-sm" id="tlPlaySelected" title="Play only the selected cue's range"><i class="bi bi-play-circle"></i></button>
            <button class="tm-icon-btn-sm" id="tlPlayPreroll" title="Play the selected cue with a short run-up and run-out, so you hear how it lands in context"><i class="bi bi-skip-backward-circle"></i></button>
            <button class="tm-icon-btn-sm" id="tlLoop" title="Loop the selected cue's range until you stop it" aria-pressed="false"><i class="bi bi-arrow-repeat"></i></button>
        </div>

        <div class="tm-timeline-toolbar-group" role="group" aria-label="Sound">
            <button class="tm-icon-btn-sm" id="tlMute" title="Mute / unmute"><i class="bi bi-volume-up-fill"></i></button>
            <input type="range" class="tm-tl-range tm-tl-range-vol" id="tlVolume" min="0" max="100" value="100"
                   title="Playback volume" aria-label="Playback volume" />
            <select id="tlSpeed" class="tm-speed-select" title="Playback speed" aria-label="Playback speed">
                <option value="0.25">0.25&times;</option>
                <option value="0.5">0.5&times;</option>
                <option value="0.75">0.75&times;</option>
                <option value="1" selected>1&times;</option>
                <option value="1.5">1.5&times;</option>
                <option value="2">2&times;</option>
            </select>
            <span class="tm-tool-sep"></span>
            <span class="tm-tl-menu-wrap">
                <button class="tm-icon-btn-sm" id="tlAudioMenuBtn" title="Waveform and playback options"
                        aria-haspopup="true" aria-expanded="false"><i class="bi bi-sliders"></i></button>
                <div class="tm-tl-menu" id="tlAudioMenu" hidden>
                    <p class="tm-tl-menu-title">Waveform</p>
                    <label class="tm-tl-menu-row" for="tlGain">
                        <span>Amplitude</span>
                        <input type="range" class="tm-tl-range" id="tlGain" min="100" max="800" value="100"
                               title="Scale the waveform vertically — useful for a quiet dialogue stem. Playback volume is unaffected." />
                        <output id="tlGainOut">1.0&times;</output>
                    </label>
                    <label class="tm-tl-menu-row" for="tlWaveView">
                        <span>Shape</span>
                        <select id="tlWaveView" class="tm-speed-select">
                            <option value="both" selected>Peaks + body</option>
                            <option value="peak">Peaks only</option>
                            <option value="rms">Loudness (RMS)</option>
                            <option value="bars">Bars</option>
                        </select>
                    </label>
                    <label class="tm-tl-menu-check">
                        <input type="checkbox" id="tlShowSpeech" checked />
                        <span>Shade detected dialogue</span>
                    </label>
                    <p class="tm-tl-menu-title">Playback</p>
                    <label class="tm-tl-menu-check">
                        <input type="checkbox" id="tlScrubAudio" />
                        <span>Play audio while scrubbing the timeline</span>
                    </label>
                    <label class="tm-tl-menu-check">
                        <input type="checkbox" id="tlAutoPauseOut" />
                        <span>Auto-pause at the selected cue's out-time</span>
                    </label>
                    <label class="tm-tl-menu-row" for="tlPreroll">
                        <span>Run-up</span>
                        <input type="range" class="tm-tl-range" id="tlPreroll" min="0" max="5000" step="250" value="1500"
                               title="How far before the cue the run-up play starts" />
                        <output id="tlPrerollOut">1.5s</output>
                    </label>
                    <p class="tm-tl-menu-title">Analysis</p>
                    <p class="tm-tl-menu-note" id="tlAudioInfo">No audio analysed yet.</p>
                    <button type="button" class="tm-btn-sm" id="tlReanalyse">Re-analyse audio</button>
                </div>
            </span>
        </div>

        <div class="tm-timeline-toolbar-group" role="group" aria-label="Timing">
            <button class="tm-icon-btn-sm" id="tlSetIn" title="Set the selected cue's in-time to the playhead"><i class="bi bi-box-arrow-in-right"></i></button>
            <button class="tm-icon-btn-sm" id="tlSetOut" title="Set the selected cue's out-time to the playhead"><i class="bi bi-box-arrow-in-left"></i></button>
            <span class="tm-tool-sep"></span>
            <button class="tm-icon-btn-sm" id="tlNudgeBack" title="Move selection slightly earlier"><i class="bi bi-arrow-left-short"></i></button>
            <button class="tm-icon-btn-sm" id="tlNudgeFwd" title="Move selection slightly later"><i class="bi bi-arrow-right-short"></i></button>
            <button class="tm-icon-btn-sm" id="tlShrink" title="Shorten duration"><i class="bi bi-dash-lg"></i></button>
            <button class="tm-icon-btn-sm" id="tlGrow" title="Extend duration"><i class="bi bi-plus-lg"></i></button>
            <select id="tlNudgeStep" class="tm-speed-select" title="Step size for nudge/duration buttons">
                <option value="frame">1 frame</option>
                <option value="10">10 ms</option>
                <option value="50" selected>50 ms</option>
                <option value="100">100 ms</option>
                <option value="500">500 ms</option>
            </select>
            <span class="tm-tool-sep"></span>
            <button class="tm-icon-btn-sm" id="tlSplitHere" title="Split the selected cue at the playhead"><i class="bi bi-scissors"></i></button>
            <button class="tm-icon-btn-sm" id="tlJoinNext" title="Join the selected cue with the one after it"><i class="bi bi-union"></i></button>
            <button class="tm-icon-btn-sm" id="tlFitSpeech" title="Snap the selected cue to the dialogue the waveform found under it"><i class="bi bi-soundwave"></i></button>
            <button class="tm-icon-btn-sm" id="tlPrevSpeech" title="Jump the playhead to the previous dialogue edge"><i class="bi bi-chevron-bar-left"></i></button>
            <button class="tm-icon-btn-sm" id="tlNextSpeech" title="Jump the playhead to the next dialogue edge"><i class="bi bi-chevron-bar-right"></i></button>
            <span class="tm-tool-sep"></span>
            <button class="tm-icon-btn-sm" id="tlDuplicate" title="Duplicate selected cue"><i class="bi bi-copy"></i></button>
            <button class="tm-icon-btn-sm" id="tlLock" title="Lock / unlock selected cue(s)"><i class="bi bi-unlock"></i></button>
            <label class="tm-timeline-toggle" title="Snap to the playhead, nearby cue edges, and frame boundaries while dragging">
                <input type="checkbox" id="tlSnap" checked /> Snap
            </label>
            <label class="tm-timeline-toggle" title="Also snap dragged cue edges to where the dialogue starts and stops in the waveform">
                <input type="checkbox" id="tlSnapAudio" checked /> Audio
            </label>
        </div>

        <div class="tm-timeline-toolbar-group" role="group" aria-label="Zoom">
            <button class="tm-icon-btn-sm" id="tlZoomOut" title="Zoom out"><i class="bi bi-zoom-out"></i></button>
            <button class="tm-icon-btn-sm" id="tlZoomFit" title="Fit whole timeline to window"><i class="bi bi-arrows-angle-contract"></i></button>
            <button class="tm-icon-btn-sm" id="tlZoomSel" title="Zoom to the selected cue"><i class="bi bi-bounding-box"></i></button>
            <button class="tm-icon-btn-sm" id="tlZoomIn" title="Zoom in"><i class="bi bi-zoom-in"></i></button>
        </div>
    </div>
    @if (isRevisor)
    {
        <!-- Submitting a round is a real form post rather than a fetch, so the
             revisor lands on their own report afterwards. -->
        <div class="tm-modal-backdrop" id="reviewModal" style="display:none;">
            <form class="tm-modal tm-review-modal" asp-controller="Review" asp-action="SubmitReview"
                  asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <h3 class="tm-modal-title"><i class="bi bi-journal-text"></i> Finish this review</h3>
                <p class="tm-modal-msg">
                    Your suggestions and flags are already saved with the project. This is the
                    note the translator reads first.
                </p>

                <label for="reviewNotes" class="tm-col-label">Report for the translator</label>
                <textarea id="reviewNotes" name="notes" rows="8" class="tm-review-notes" dir="auto"
                          placeholder="What you changed and why, patterns worth watching for, anything they should check…"></textarea>
                <p class="tm-review-stats" id="reviewStats"></p>

                <div class="tm-review-verdict">
                    <label>
                        <input type="radio" name="verdict" value="@((int)ReviewVerdict.ChangesRequested)" checked />
                        <span><strong>Send back</strong> — the translator works through your suggestions.</span>
                    </label>
                    <label>
                        <input type="radio" name="verdict" value="@((int)ReviewVerdict.Approved)" />
                        <span><strong>Approve</strong> — this is ready to deliver.</span>
                    </label>
                </div>

                <div class="tm-modal-actions">
                    <button type="button" class="tm-btn-sm" id="cancelReview" style="padding:8px 20px;">Cancel</button>
                    <button type="submit" class="tm-btn tm-btn-primary" style="width:auto;">
                        <i class="bi bi-send-check"></i> Submit review
                    </button>
                </div>
            </form>
        </div>
    }

    <div class="tm-timeline-wrap" id="timelineWrap">
        <div class="tm-timeline-scroll" id="timelineScroll">
            <div class="tm-timeline-inner" id="timelineInner">
                <canvas id="waveformCanvas"></canvas>
                <div class="tm-timeline-hover" id="timelineHover"></div>
                <div class="tm-timeline-cursor" id="timelineCursor"></div>
                <div class="tm-timeline-events" id="timelineEvents"></div>
                <div class="tm-timeline-timecodes" id="timelineTimecodes"></div>
            </div>
        </div>
        <!-- Overlays: they float above the strip rather than taking layout
             space, so the waveform keeps the full height the user gave it. -->
        <div class="tm-timeline-readout" id="timelineReadout" hidden></div>
        <div class="tm-timeline-progress" id="timelineProgress" hidden>
            <span class="tm-timeline-progress-label" id="timelineProgressText">Analysing audio…</span>
            <span class="tm-timeline-progress-track"><span class="tm-timeline-progress-fill" id="timelineProgressFill"></span></span>
        </div>
    </div>

</div>

@section Scripts {
<script>
    const PROJECT_ID   = @Model.Id;
    // The editor branches on this rather than asking the server again.
    const USER_ROLE    = "@ViewBag.Role";
    const CAN_EDIT_TRANSLATION = @((bool)ViewBag.CanEditTranslation ? "true" : "false");
    const CAN_REVIEW   = @((bool)ViewBag.CanReview ? "true" : "false");

</script>
<script src="https://cdn.jsdelivr.net/npm/mammoth@1.8.0/mammoth.browser.min.js"></script>
<script src="~/js/subtitle-core.js" asp-append-version="true"></script>
<script src="~/js/waveform.js" asp-append-version="true"></script>
<script src="~/js/shortcuts.js" asp-append-version="true"></script>
<script src="~/js/editor.js" asp-append-version="true"></script>
}
