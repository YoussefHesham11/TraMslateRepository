@model TraMslate.ViewModels.ManageAccountViewModel
@{ ViewData["Title"] = "Your account"; }

<div style="max-width: 560px; margin: 0 auto;">

    <div class="tm-page-header" style="margin-bottom: 28px;">
        <div>
            <h1 class="tm-page-title">Your account</h1>
            <p class="tm-page-sub">@Model.Email</p>
        </div>
        <a asp-controller="Dashboard" asp-action="Index" class="tm-btn" style="width:auto; background:var(--surface2); color:var(--text-muted);">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    @if (TempData["AccountNotice"] is string notice)
    {
        <div class="tm-notice tm-notice-ok" role="status"><i class="bi bi-check-circle-fill"></i> @notice</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="tm-alert-danger">@Html.ValidationSummary(false)</div>
    }

    <div class="tm-card" style="margin-bottom:20px;">
        <h2 class="tm-section-title"><i class="bi bi-person"></i> Profile</h2>
        <p class="tm-tool-hint" style="margin-top:0;">Your name is what translators and revisors see on shared projects and review reports.</p>
        <form asp-action="UpdateProfile" method="post">
            @Html.AntiForgeryToken()
            <div class="tm-form-group">
                <label asp-for="Profile.FullName">Full Name</label>
                <input asp-for="Profile.FullName" type="text" autocomplete="name" />
            </div>
            <div class="tm-form-group">
                <label asp-for="Profile.LanguageSpecialty">Language Specialty <span style="color:var(--text-muted); font-weight:400;">(optional)</span></label>
                <input asp-for="Profile.LanguageSpecialty" type="text" placeholder="e.g. English → Arabic" />
            </div>
            <button type="submit" class="tm-btn tm-btn-primary"><i class="bi bi-check-lg"></i> Save profile</button>
        </form>
    </div>

    <div class="tm-card">
        <h2 class="tm-section-title"><i class="bi bi-key"></i> Password</h2>
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div class="tm-form-group">
                <label asp-for="Password.CurrentPassword">Current Password</label>
                <input asp-for="Password.CurrentPassword" type="password" autocomplete="current-password" />
            </div>
            <div class="tm-form-group">
                <label asp-for="Password.NewPassword">New Password</label>
                <input asp-for="Password.NewPassword" type="password" autocomplete="new-password" placeholder="At least 8 characters, including a digit" />
            </div>
            <div class="tm-form-group">
                <label asp-for="Password.ConfirmPassword">Confirm New Password</label>
                <input asp-for="Password.ConfirmPassword" type="password" autocomplete="new-password" />
            </div>
            <button type="submit" class="tm-btn tm-btn-primary"><i class="bi bi-shield-lock"></i> Change password</button>
        </form>
    </div>
</div>
